{
  "name": "@agentforge/composition",
  "version": "0.1.0",
  "description": "Composition constructs for multi-agent systems — workflows, teams, routing, handoffs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentforge/constructs": "workspace:*",
    "@agentforge/core": "workspace:*",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
